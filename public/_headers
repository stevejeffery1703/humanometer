/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; connect-src 'self'; frame-src https://js.stripe.com; img-src 'self' data:

# HTML must revalidate on every load so a returning visitor never runs a fresh
# app.js against an hour-stale index.html (they'd be from different deploys).
# The previous `max-age=3600` here would have caused exactly that — but Workers
# Assets ignores a per-file Cache-Control on the HTML entrypoint and already
# serves it `max-age=0, must-revalidate` (verified against prod), so no skew
# exists today. This pins that safe intent explicitly and guards a future move
# to Cloudflare Pages, where a per-file HTML cache rule *is* honored. Both
# index.html and app.js carry ETags, so each revalidation is a cheap 304.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.svg
  Cache-Control: public, max-age=31536000, immutable